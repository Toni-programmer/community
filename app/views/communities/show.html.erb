<div class="comunity-container">
  <div class="comunity-box">
    <p style="color: green"><%= notice %></p>
    <%= render @community %>
    <br>
    <div>
      <ul class="nav flex-column gap-2">
        <li class="nav-item">
          <%= link_to "Editar esta comunidad", edit_community_path(@community), class: "btn btn-outline-primary" %>
        </li>
        <li class="nav-item">
          <%= link_to "Volver atrás", communities_path, class: "btn btn-outline-primary" %>
        </li>
        <li class="nav-item">
          <%= button_to "Eliminar esta comunidad", @community, method: :delete, class: "btn btn-outline-danger" %>
        </li>
      </ul>
    </div>
  </div>
</div>
