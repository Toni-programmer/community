<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="common_areas">
  <%= link_to new_common_area_path, class: "btn btn-success btn-sm w-200px" do %>
    <i class="fa fa-plus"></i> Nuevo 
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Comunidad</th>
        <th>Nombre</th>
        <th>Tipo de zona</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @common_areas.each do |common_area| %>
        <tr>
          <td><%= common_area.community.name %></td>
          <td><%= common_area.name %></td>
          <td><%= CommonArea.area_types[common_area.area_type.presence] || "-" %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", common_area, class: "dropdown-item" %>
              <%= link_to "Editar", edit_common_area_path(common_area), class: "dropdown-item" %>
              <%= link_to "Eliminar", common_area, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
