<!-- lib/templates/erb/scaffold/show.html.erb.tt -->
<div class="card card-body w-100 w-xl-50">
  <table class="table">
    <tbody>
      <tr>
        <td><strong>Comunidad</strong></td>
        <td><%= @incidence.community.presence.name || "-" %></td>
      </tr>
      <tr>
        <td><strong>Usuario</strong></td>
        <td><%= @incidence.user.presence.full_name || "-" %></td>
      </tr>
      <tr>
        <td><strong>Descripción</strong></td>
        <td><%= @incidence.description.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Fecha</strong></td>
        <td><%= @incidence.date.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Estado</strong></td>
        <td><%= Incidence.statuses[@incidence.status.presence] || "-" %></td>
      </tr>
      <tr>
        <td><strong>Foto</strong></td>
        <td><%= @incidence.photo.presence || "-" %></td>
      </tr>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-start mt-4 mb-8">
  <%= link_to "← Atrás", incidences_path, class: "me-1" %> |
  <%= link_to "Editar", edit_incidence_path(@incidence), class: "ms-1" %>
</div>
