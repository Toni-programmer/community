<div id="<%= dom_id incidence %>">
  <div>
    <strong>Comunidad:</strong>
    <%= incidence.community_id %>
  </div>
  <div>
    <strong>Usuario:</strong>
    <%= incidence.user_id %>
  </div>
  <div>
    <strong>Descripción:</strong>
    <%= incidence.description %>
  </div>
  <div>
    <strong>Fecha:</strong>
    <%= incidence.date %>
  </div>
  <div>
    <strong>Estado:</strong>
    <%= incidence.status %>
  </div>
  <div>
    <strong>Foto:</strong>
    <%= incidence.photo %>
  </div>
</div>
