<h2>Cambiar tu contraseña</h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <div class="field">
    <p><%= f.label :contraseña, "Nueva contraseña" %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "Nueva contraseña" %></p>
  </div>
  <div class="field">
    <p><%= f.label :Confirmar_contraseña, "Confirm nueva contraseña" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "Nueva contraseña" %></p>
  </div>
  <div class="actions">
    <%= f.submit "Cambiar mi contraseña" %>
  </div>
<% end %>
<%= render "devise/shared/links" %>
