<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="maintenances">
  <% if current_user.admin? %>
    <%= link_to new_maintenance_path, class: "btn btn-success btn-sm w-200px" do %>
      <i class="fa fa-plus"></i> Mantenimiento
    <% end %>
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Zona común</th>
        <th>Proveedor</th>
        <th>Descripción</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @maintenances.each do |maintenance| %>
        <tr>
          <td><%= maintenance.common_area&.name || "-" %></td>
          <td><%= maintenance.supplier&.name || "-" %></td>
          <td><%= maintenance.description %></td>
          <td><%= Maintenance.statuses[maintenance.status.presence] || "-" %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", maintenance, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Editar", edit_maintenance_path(maintenance), class: "dropdown-item" %>
                <%= link_to "Eliminar", maintenance, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
