<!-- lib/templates/erb/scaffold/show.html.erb.tt -->
<div class="card card-body w-100 w-xl-50">
  <table class="table">
    <tbody>
      <tr>
        <td><strong>Comunidad</strong></td>
        <td><%= @notice.community.name || "-" %></td>
      </tr>
      <tr>
        <td><strong>Nombre</strong></td>
        <td><%= @notice.name.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Concepto</strong></td>
        <td><%= @notice.concept.presence || "-" %></td>
      </tr>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-start mt-4 mb-8">
  <%= link_to "← Atrás", notices_path, class: "me-1" %> |
  <%= link_to "Editar", edit_notice_path(@notice), class: "ms-1" %>
</div>
