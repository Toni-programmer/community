<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="notices">
  <% if current_user.admin? %>
    <%= link_to new_notice_path, class: "btn btn-success btn-sm w-200px" do %>
      <i class="fa fa-plus"></i> Nuevo Aviso
    <% end %>
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Comunidad</th>
        <th>Nombre</th>
        <th>Concepto</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @notices.each do |notice| %>
        <tr>
          <td><%= notice.community.name %></td>
          <td><%= notice.name %></td>
          <td><%= notice.concept %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", notice, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Editar", edit_notice_path(notice), class: "dropdown-item" %>
                <%= link_to "Eliminar", notice, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="d-flex justify-content-center mt-2">
    <%= will_paginate @receipts,
      previous_label: "← Anterior",
      next_label: "Siguiente →",
      class: "pagination pagination-sm mb-0" %>
  </div>
</div>
