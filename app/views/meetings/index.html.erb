<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="meetings">
  <% if current_user.admin? %>
    <%= link_to new_meeting_path, class: "btn btn-success btn-sm w-200px" do %>
      <i class="fa fa-plus"></i> Nueva Reunión
    <% end %>
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Comunidad</th>
        <th>Fecha</th>
        <th>Tipo de reunión</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @meetings.each do |meeting| %>
        <tr>
          <td><%= meeting.community.name %></td>
          <td><%= meeting.date&.strftime("%d-%m-%Y") %></td>
          <td><%= Meeting.type_meetings[meeting.type_meeting.presence] || "-" %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", meeting, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Editar", edit_meeting_path(meeting), class: "dropdown-item" %>
                <%= link_to "Eliminar", meeting, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
