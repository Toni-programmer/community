<!-- lib/templates/erb/scaffold/_form.html.erb.tt -->
<% if meeting.errors.any? %>
  <div class="alert alert-danger d-flex align-items-center p-5">
    <i class="fa-solid fa-xmark-circle fs-2x text-danger me-4"></i>
    <div class="d-flex flex-column">
      <h4 class="mb-1 text-danger">
        No se ha podido realizar la acción
      </h4>
      <span class="ms-4">
        <% meeting.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </span>
    </div>
  </div>
<% end %>
<div class="card card-body mb-8">
  <%= form_with model: meeting, data: { turbo: false } do |form| %>
    <div class="mb-4">
      <%= form.label :Comunidad, class: "form-label" %>
      <%= form.collection_select(:community_id, Community.all, :id, :name, prompt: "Elige una comunidad") %>
    </div>
    <div class="mb-4">
      <%= form.label :Fecha, class: "form-label" %>
      <%= form.date_field :date, class: "form-control form-control-solid", required:true %>
    </div>
    <div class="mb-4">
      <%= form.label :Tipo_reunión, class: "form-label" %>
      <%= form.collection_select(:type_meeting, Meeting.type_meetings, :first, :second, prompt: "Elige tipo de acta") %>
    </div>
    <div class="mt-8">
      <%= form.button "Guardar", class: "btn btn-success btn-sm" %>
      <%= link_to "Cancelar", meeting.persisted? ? meeting : meetings_path, class: "btn btn-link btn-sm btn-color-muted btn-active-color-success ms-4" %>
    </div>
  <% end %>
</div>