<!-- lib/templates/erb/scaffold/show.html.erb.tt -->
<div class="card card-body w-100 w-xl-50">
  <table class="table">
    <tbody>
      <tr>
        <td><strong>Comunidad</strong></td>
        <td><%= @meeting.community.presence.name || "-" %></td>
      </tr>
      <tr>
        <td><strong>Fecha</strong></td>
        <td><%= @meeting.date.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Tipo de reunión</strong></td>
        <td><<%= Meeting.type_meetings[@meeting.type_meeting.presence] || "-" %>/td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="flex items-center justify-start mt-4 mb-8">
      <%= link_to "← Atrás", meetings_path, class: "me-1" %> |
      <%= link_to "Editar", edit_meeting_path(@meeting), class: "ms-1" %>
    </div>
