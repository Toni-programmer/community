<div id="<%= dom_id expense %>">
  <div>
    <strong>Caja:</strong>
    <%= expense.cash_balance_id %>
  </div>
  <div>
    <strong>Proveedores:</strong>
    <%= expense.supplier_id %>
  </div>
  <div>
    <strong>Incidencias:</strong>
    <%= expense.incidence_id %>
  </div>
  <div>
    <strong>Cantidad:</strong>
    <%= expense.amount %>
  </div>
  <div>
    <strong>Fecha:</strong>
    <%= expense.date %>
  </div>
  <div>
    <strong>Estado:</strong>
    <%= expense.status %>
  </div>
</div>
