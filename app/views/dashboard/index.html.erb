<div class="container-fluid py-4">
  <div class="row mb-4 text-center">
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <h6 class="text-muted">Saldo en Cuenta</h6>
        <h3 class="text-success">
          <%= number_to_currency(@total_balance, unit: "€", format: "%n %u", delimiter: ".", separator: ",") %>
        </h3>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <h6 class="text-muted">Morosidad</h6>
        <h3 class="text-danger"><%= @morosidad %>%</h3>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm p-3">
        <h6 class="text-muted">Incidencias Abiertas</h6>
        <h3><%= @open_incidences_count %></h3>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8 mb-4">
      <div class="card shadow-sm p-4">
        <h5>Balance Ingresos vs Gastos <%= Date.current.year %></h5>
        <canvas
          data-controller="chart"
          data-chart-labels-value="<%= @chart_labels.to_json %>"
          data-chart-receipts-value="<%= @chart_receipts.to_json %>"
          data-chart-expenses-value="<%= @chart_expenses.to_json %>">
        </canvas>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card shadow-sm p-4">
        <h5>Últimas Incidencias</h5>
        <% if @recent_incidences.any? %>
          <ul class="list-group list-group-flush">
            <% @recent_incidences.each do |incidence| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="text-truncate me-2"><%= incidence.description %></span>
                <% if incidence.status == "Pendiente" %>
                  <span class="badge bg-warning text-dark">Pendiente</span>
                <% else %>
                  <span class="badge bg-success">Completado</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mt-2">No hay incidencias registradas.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
