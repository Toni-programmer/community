<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Comunidad de Vecinos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
      body { background-color: #f8f9fa; }

      .card { border: none; border-radius: 10px; }
    </style>
  </head>
  <body>
    <div class="container-fluid" >
      <div class="row">
        <main class="col-12 px-md-4 py-4">
          <div class="row mb-4 text-center">
            <div class="col-md-4">
              <div class="card shadow-sm p-3">
                <h6 class="text-muted">Saldo en Cuenta</h6>
                <h3 class="text-success">
                  <%= number_to_currency(@total_balance, unit: "€", format: "%n %u", delimiter: ".", separator: ",") %>
                </h3>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card shadow-sm p-3">
                <h6 class="text-muted">Morosidad</h6>
                <h3 class="text-danger">3.5%</h3>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card shadow-sm p-3">
                <h6 class="text-muted">Incidencias Abiertas</h6>
                <h3>5</h3>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-lg-8 mb-4">
              <div class="card shadow-sm p-4">
                <h5>Balance Ingresos vs Gastos</h5>
                <canvas id="graficoFinanzas" width="400" height="200"></canvas>
              </div>
            </div>
            <div class="col-lg-4">
              <div class="card shadow-sm p-4 text-center">
                <h5>Estado de Averías</h5>
                <ul class="list-group list-group-flush text-start">
                  <li class="list-group-item d-flex justify-content-between">Ascensor 1 <span class="badge bg-warning">En Proceso</span></li>
                  <li class="list-group-item d-flex justify-content-between">Piscina <span class="badge bg-success">Reparado</span></li>
                  <li class="list-group-item d-flex justify-content-between">Limpieza <span class="badge bg-info">Programado</span></li>
                </ul>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      let graficoFinanzas;

      document.addEventListener('turbo:load', function() {
        const canvas = document.getElementById('graficoFinanzas');

        if (!canvas) return;

        const ctx = canvas.getContext('2d');


        if (graficoFinanzas) {
          graficoFinanzas.destroy();
        }

        graficoFinanzas = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
            datasets: [{
              label: 'Ingresos',
              data: [12000, 15000, 14000, 18000, 17000, 16000],
              backgroundColor: '#3498db'
            }, {
              label: 'Gastos',
              data: [10000, 11000, 13000, 9000, 12000, 14000],
              backgroundColor: '#e74c3c'
            }]
          },
          options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
          }
        });
      });
    </script>
  </body>
</html>