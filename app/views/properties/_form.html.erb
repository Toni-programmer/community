<!-- lib/templates/erb/scaffold/_form.html.erb.tt -->
<% if property.errors.any? %>
  <div class="alert alert-danger d-flex align-items-center p-5">
    <i class="fa-solid fa-xmark-circle fs-2x text-danger me-4"></i>
    <div class="d-flex flex-column">
      <h4 class="mb-1 text-danger">
        No se ha podido realizar la acción
      </h4>
      <span class="ms-4">
        <% property.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </span>
    </div>
  </div>
<% end %>
<div class="card card-body mb-8">
  <%= form_with model: property, data: { turbo: false } do |form| %>
    <div class="mb-4">
      <%= form.label :Usuario, class: "form-label" %>
      <%= form.collection_select(:user_id, User.all, :id, :full_name, prompt: "Elige un usuario") %>
    </div>
    <div class="mb-4">
      <%= form.label :Comunidad, class: "form-label" %>
      <%= form.collection_select(:community_id, Community.all, :id, :name, prompt: "Elige una comunidad") %>
    </div>
    <div class="mb-4">
      <%= form.label :Número, class: "form-label" %>
      <%= form.text_field :number, class: "form-control form-control-solid", required: true %>
    </div>
    <div class="mb-4">
      <%= form.label :Estado_morosidad, class: "form-label" %>
      <%= form.collection_select(:payment_status, Property.payment_statuses, :first, :second, prompt: "Elige un estado") %>
    </div>
    <div class="mb-4">
      <%= form.label :Pago_atrasado, class: "form-label" %>
      <%= form.checkbox :late_payment %>
    </div>
    <div class="mb-4">
      <%= form.label :Total_propietarios, class: "form-label" %>
      <%= form.number_field :total_owners, class: "form-control form-control-solid", required: true %>
    </div>
    <div class="mt-8">
      <%= form.button "Guardar", class: "btn btn-success btn-sm" %>
      <%= link_to "Cancelar", property.persisted? ? property : properties_path, class: "btn btn-link btn-sm btn-color-muted btn-active-color-success ms-4" %>
    </div>
  <% end %>
</div>