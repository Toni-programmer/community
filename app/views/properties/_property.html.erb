<div id="<%= dom_id property %>">
  <div>
    <strong>Usuario:</strong>
    <%= property.user_id %>
  </div>
  <div>
    <strong>Comunidad:</strong>
    <%= property.community_id %>
  </div>
  <div>
    <strong>Numero:</strong>
    <%= property.number %>
  </div>
  <div>
    <strong>Estado morosidad:</strong>
    <%= property.payment_status %>
  </div>
  <div>
    <strong>Pago atrasado:</strong>
    <%= property.late_payment %>
  </div>
  <div>
    <strong>Total propietarios:</strong>
    <%= property.total_owners %>
  </div>
</div>
