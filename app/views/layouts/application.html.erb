<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Comunity" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Comunity">
    <meta name="mobile-web-app-capable" content="yes">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%# bootstrap%>
  </head>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <body>
    <section class="appcontainer">
      <div class="appSlide">
        <%= image_tag "gestion_comunidades.png", class: "img-fluid photo", id: "image" %>
        <ul class="nav flex-column">
          <% if user_signed_in? %>
            <li class="nav-item">
              <span class="nav-link"><%= current_user.full_name %></span>
            </li>
            <li class="nav-item">
              <%= link_to "Inicio", root_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Avisos", notices_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Zonas comunes", common_areas_path, class: "nav-link menu-item" %>
            </li>
            <%if current_user.admin?%>
              <li class="nav-item">
                <%= link_to "Comunidad", communities_path, class: "nav-link menu-item" %>
              </li>
            <%end%>
            <li class="nav-item">
              <%= link_to "Gastos", expenses_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Incidencias", incidences_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Reuniones", meetings_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Proveedores", suppliers_path, class: "nav-link menu-item" %>
            </li>
            <%if current_user.admin?%>
              <li class="nav-item">
                <%= link_to "Recibos", receipts_path, class: "nav-link menu-item" %>
              </li>
            <%end%>
            <li class="nav-item">
              <%= link_to "Reservas", reservations_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Mantenimiento", maintenances_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Caja", cash_balances_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Propietarios", properties_path, class: "nav-link menu-item" %>
            </li>
            <% if current_user.admin? %>
              <li class="nav-item">
                <%= link_to "Administración", users_path, class: "nav-link menu-item" %>
              </li>
            <% end %>
            <li class="nav-item">
              <%= link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "nav-link menu-item" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "Iniciar sesión", new_user_session_path, class: "nav-link menu-item" %>
            </li>
            <li class="nav-item">
              <%= link_to "Crear cuenta", new_user_registration_path, class: "nav-link menu-item" %>
            </li>
          <% end %>
        </ul>
      </div>
      <div class="appcontent">
        <div class="appHeader">
          <div>Gestion de COMUNIDADES</div>
          <div class="contact">
            <%= mail_to "admin@admin.com", "Contáctanos", class: "nav-link menu-item"  %>
          </div>
        </div>
        <div class="appyield">
          <%= yield %>
        </div>
      </div>
    </section>
  </body>
</html>