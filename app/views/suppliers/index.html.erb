<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="suppliers">
  <% if current_user.admin? %>
    <%= link_to new_supplier_path, class: "btn btn-success btn-sm w-200px" do %>
      <i class="fa fa-plus"></i> Proveedores
    <% end %>
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Nombre</th>
        <th>Servicio</th>
        <th>Contacto</th>
        <th>Cif</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @suppliers.each do |supplier| %>
        <tr>
          <td><%= supplier.name %></td>
          <td><%= supplier.service %></td>
          <td><%= supplier.contact %></td>
          <td><%= supplier.cif %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", supplier, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Editar", edit_supplier_path(supplier), class: "dropdown-item" %>
                <%= link_to "Eliminar", supplier, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
