<!-- lib/templates/erb/scaffold/show.html.erb.tt -->
<div class="card card-body w-100 w-xl-50">
  <table class="table">
    <tbody>
      <tr>
        <td><strong>Popietario</strong></td>
        <td><%= @receipt.property.presence.id || "-" %></td>
      </tr>
      <tr>
        <td><strong>Caja</strong></td>
        <td><%= @receipt.cash_balance.presence.financial_year || "-" %></td>
      </tr>
      <tr>
        <td><strong>Fecha</strong></td>
        <td><%= @receipt.date.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Mensualidad</strong></td>
        <td><%= @receipt.monthly_price.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Estado</strong></td>
        <td><%= Receipt.statuses[@receipt.status.presence] || "-" %></td>
      </tr>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-start mt-4 mb-8">
  <%= link_to "← Atrás", receipts_path, class: "me-1" %> |
  <%= link_to "Editar", edit_receipt_path(@receipt), class: "ms-1" %>
</div>
