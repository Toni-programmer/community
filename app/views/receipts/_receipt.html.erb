<div id="<%= dom_id receipt %>">
  <div>
    <strong>Propietario:</strong>
    <%= receipt.property_id %>
  </div>
  <div>
    <strong>Caja:</strong>
    <%= receipt.cash_balance_id %>
  </div>
  <div>
    <strong>Fecha:</strong>
    <%= receipt.date %>
  </div>
  <div>
    <strong>Mensualidad:</strong>
    <%= receipt.monthly_price %>
  </div>
  <div>
    <strong>Estado:</strong>
    <%= receipt.status %>
  </div>
</div>
