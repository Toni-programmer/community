<!-- lib/templates/erb/scaffold/_form.html.erb.tt -->
<% if receipt.errors.any? %>
  <div class="alert alert-danger d-flex align-items-center p-5">
    <i class="fa-solid fa-xmark-circle fs-2x text-danger me-4"></i>
    <div class="d-flex flex-column">
      <h4 class="mb-1 text-danger">
        No se ha podido realizar la acción
      </h4>
      <span class="ms-4">
        <% receipt.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </span>
    </div>
  </div>
<% end %>
<div class="card card-body mb-8">
  <%= form_with model: receipt, data: { turbo: false } do |form| %>
    <div class="mb-4">
      <%= form.label :Propietarios, class: "form-label" %>
      <%= form.collection_select(:property_id, Property.all, :id, :user_name, prompt: "Elige propietario") %>
    </div>
    <div class="mb-4">
      <%= form.label :Caja, class: "form-label" %>
      <%= form.collection_select(:cash_balance_id, CashBalance.all, :id, :community_name, prompt: "Elige comunidad") %>
    </div>
    <div class="mb-4">
      <%= form.label :Fecha, class: "form-label" %>
      <%= form.date_field :date, class: "form-control form-control-solid", required: true %>
    </div>
    <div class="mb-4">
      <%= form.label :Mensualidad, class: "form-label" %>
      <%= form.text_field :monthly_price, class: "form-control form-control-solid", required: true %>
    </div>
    <div class="mb-4">
      <%= form.label :Estado, class: "form-label" %>
      <%= form.collection_select(:status, Receipt.statuses, :first, :second, prompt: "Elige un estado") %>
    </div>
    <div class="mt-8">
      <%= form.button "Guardar", class: "btn btn-success btn-sm" %>
      <%= link_to "Cancelar", receipt.persisted? ? receipt : receipts_path, class: "btn btn-link btn-sm btn-color-muted btn-active-color-success ms-4" %>
    </div>
  <% end %>
</div>