<div id="<%= dom_id cash_balance %>">
  <div>
    <strong>Comunidad:</strong>
    <%= cash_balance.community_id %>
  </div>
  <div>
    <strong>Año Financiero:</strong>
    <%= cash_balance.financial_year %>
