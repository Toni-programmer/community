<!-- lib/templates/erb/scaffold/index.html.erb.tt -->
<div class="card card-body" id="cash_balances">
  <% if current_user.admin? %>
    <%= link_to new_cash_balance_path, class: "btn btn-success btn-sm w-200px" do %>
      <i class="fa fa-plus"></i> Nuevo
    <% end %>
  <% end %>
  <div class="separator mt-10 mb-3"></div>
  <table class="table table-hover table-rounded table-striped gy-7 gs-7">
    <thead>
      <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0 ">
        <th>Comunidad</th>
        <th>Año Financiero</th>
        <th>Cuenta Corriente</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @cash_balances.each do |cash_balance| %>
        <tr>
          <td><%= cash_balance.community.name %></td>
          <td><%= cash_balance.financial_year %></td>
          <td><%= cash_balance.current_amount %></td>
          <td><%= CashBalance.statuses[cash_balance.status.presence] || "-" %></td>
          <td class="text-end">
            <button
            type="button"
            class="btn btn-light btn-active-light-primary dropdown-toggle dropdown-toggle-split ms-4"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
          >
              Acciones
            </button>
            <div class="dropdown-menu"  style="border: 1px solid #ECECEC">
              <%= link_to "Ver", cash_balance, class: "dropdown-item" %>
              <% if current_user.admin? %>
                <%= link_to "Editar", edit_cash_balance_path(cash_balance), class: "dropdown-item" %>
                <%= link_to "Eliminar", cash_balance, class: "dropdown-item", data: {turbo_method: :delete, turbo_confirm: "¿Estás seguro?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
