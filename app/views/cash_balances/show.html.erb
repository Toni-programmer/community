<!-- lib/templates/erb/scaffold/show.html.erb.tt -->
<div class="card card-body w-100 w-xl-50">
  <table class="table">
    <tbody>
      <tr>
        <td><strong>Comunidad</strong></td>
        <td><%= @cash_balance.community.name || "-" %></td>
      </tr>
      <tr>
        <td><strong>Año financiero</strong></td>
        <td><%= @cash_balance.financial_year.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Cuenta corriente</strong></td>
        <td><%= @cash_balance.current_amount.presence || "-" %></td>
      </tr>
      <tr>
        <td><strong>Estado</strong></td>
        <td><%= CashBalance.statuses[@cash_balance.status.presence] || "-" %></td>
      </tr>
    </tbody>
  </table>
</div>
<div class="flex items-center justify-start mt-4 mb-8">
  <%= link_to "← Atrás", cash_balances_path, class: "me-1" %> |
  <%= link_to "Editar", edit_cash_balance_path(@cash_balance), class: "ms-1" %>
</div>
